# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_USER=obe_admin
PG_PASSWORD=change_me
PG_DATABASE=obe_system

# Server
PORT=4000
NODE_ENV=development

# Puppeteer: set to "true" to download Chromium on first run (default).
# On servers without Chromium, point this to an installed Chrome binary.
PUPPETEER_EXECUTABLE_PATH=

# Attainment threshold (percentage 0-100). Students scoring >= this on a
# question are counted as having "attained" that question's CO contribution.
ATTAINMENT_THRESHOLD=60
